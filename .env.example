NODE_ENV=development
PORT=5173
API_PORT=3000
APP_ORIGIN=http://localhost:5173
DATABASE_PROVIDER=postgresql
DATABASE_URL=postgresql://roi_bcu:REPLACE_WITH_POSTGRES_PASSWORD@127.0.0.1:5543/roi_bcu?schema=public&connection_limit=8
# Windows: PostgreSQL 17 harus sudah terpasang.
# Kosongkan LOCAL_POSTGRES_DIR untuk server PostgreSQL lain atau Docker.
LOCAL_POSTGRES_DIR=./data/postgresql
LOCAL_POSTGRES_BIN=C:/Program Files/PostgreSQL/17/bin
LOCAL_POSTGRES_PORT=5543
POSTGRES_USER=roi_bcu
POSTGRES_DB=roi_bcu
POSTGRES_PASSWORD=REPLACE_WITH_POSTGRES_PASSWORD
POSTGRES_ADMIN_PASSWORD=REPLACE_WITH_POSTGRES_ADMIN_PASSWORD
DATA_DIR=./data
SESSION_SECRET=REPLACE_WITH_AT_LEAST_48_RANDOM_CHARACTERS
ENCRYPTION_KEY=REPLACE_WITH_64_HEXADECIMAL_CHARACTERS
ADMIN_EMAIL=admin@bcupt.id
ADMIN_PASSWORD=REPLACE_WITH_A_STRONG_INITIAL_PASSWORD
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
TRUST_PROXY=0
TINY_LICENSE_KEY=gpl
